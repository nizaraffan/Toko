<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DetailController"
            stylesheets="@styles/app.css">

    <top>
        <HBox spacing="16" styleClass="header">

            <Label text="Detail Produk"
                   styleClass="title"/>

            <Button text="Kembali ke Daftar"
                    onAction="#bukaDaftar"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="page">

            <VBox spacing="12" styleClass="card">

                <Label text="Kode Produk"/>
                <Label fx:id="kodeLabel"
                       styleClass="subtitle"/>

                <Label text="Nama Produk"/>
                <Label fx:id="namaLabel"
                       styleClass="subtitle"/>

                <Label text="Kategori"/>
                <Label fx:id="kategoriLabel"/>

                <Label text="Harga Produk"/>
                <Label fx:id="hargaLabel"
                       styleClass="title"/>

                <Button text="Tambah Produk Lain"
                        onAction="#tambahLagi"
                        styleClass="button-primary"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>
